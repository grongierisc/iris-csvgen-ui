    ; run installer to create namespace
    do $SYSTEM.OBJ.Load("/opt/irisapp/Installer.cls", "ck")
    set sc = ##class(App.Installer).setup() 

    zn "IRISAPP"

    zpm
    load "/opt/irisapp"
    q

    zn "%SYS"
    Do ##class(Security.Users).UnExpireUserPasswords("*")

    ; call your initial methods here
    halt
